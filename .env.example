# ---------------------------------------------------------------------------
# Single source of environment for `docker compose`. Copy to `.env` and fill in.
#   cp .env.example .env
#
# Compose reads `.env` from this directory automatically. On Coolify, set these
# same keys in the application's environment UI instead of shipping a file.
# ---------------------------------------------------------------------------

# --- Postgres -------------------------------------------------------------
# Consumed by the `postgres` service and woven into DATABASE_URL below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=unipay

# --- server (NestJS) ------------------------------------------------------
# `postgres` is the compose service name, so this resolves on the internal
# network. Point it at a managed database to drop the postgres service.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/unipay?schema=public

# The server refuses to boot without these four (see server/src/config/configuration.ts).
ENCRYPTION_MASTER_KEY=          # openssl rand -base64 32  -> must decode to 32 bytes
PRIVY_APP_ID=
PRIVY_APP_SECRET=
MERCHANT_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Every browser origin that calls the API. The client's nginx port belongs here
# too, otherwise its fetches are blocked.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- business (Next.js) ---------------------------------------------------
# BUILD-TIME. Next inlines NEXT_PUBLIC_* into the bundle, so changing either of
# these needs a rebuild (`docker compose build business`), not a restart.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_PRIVY_APP_ID=

# RUNTIME. Read only by server-side code, which cannot use the public URL above:
# inside a container `localhost` is the Next container itself, not the API.
INTERNAL_API_URL=http://server:3001

# --- client (Vite) --------------------------------------------------------
# BUILD-TIME, same rebuild caveat as the Next.js vars above. Each falls back to
# a hardcoded default in client/src/config/ when left empty.
VITE_REOWN_PROJECT_ID=
VITE_UNIPAY_TREASURY_ADDRESS=
VITE_UNIPAY_TESTNET_TREASURY_ADDRESS=

# --- host port mapping ----------------------------------------------------
# Coolify assigns its own routing, so these only matter for local runs.
BUSINESS_PORT=3000
SERVER_PORT=3001
CLIENT_PORT=8080
POSTGRES_PORT=5432
