# ==============================================================================
# Yucarn (Client) Environment Variables
# ==============================================================================
# Copy this file to `.env` in the `client/` folder:
#   cp .env.example .env
#
# Vite automatically injects any variable prefixed with `VITE_` into the app.
# All variables below have safe fallback defaults if left empty.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Reown AppKit / WalletConnect Cloud Project ID
# ------------------------------------------------------------------------------
# Get your free Project ID from: https://cloud.reown.com or https://dashboard.reown.com
# Enables email/social logins, multi-chain connections (EVM, Solana, Sui, Bitcoin),
# QR modal scanning, and 300+ wallet connectors.
# (VITE_PROJECT_ID and VITE_REOWN_PROJECT_ID are interchangeable)
VITE_PROJECT_ID=
VITE_REOWN_PROJECT_ID=b56e18d47c72ab683b10814fe9495694

# ------------------------------------------------------------------------------
# 2. Automated Background Relayer Keys (Gasless 1-Click Settlement)
# ------------------------------------------------------------------------------
# Setting these keys enables automated background gasless relaying for destination chains:
# - Zero wallet network switching prompts for the user
# - Zero destination gas required from sender or recipient
# - Automatic 1-click cross-chain settlement from source burn to destination mint
#
# EVM Relayer Private Key (64 hex characters with 0x prefix)
# Used to sponsor/mint destination transactions on EVM chains (Arc, Sonic, Ink, World Chain, Plume, Morph, etc.)
VITE_RELAYER_PRIVATE_KEY=

# Sui Relayer Private Key (0x... hex or suiprivkey...)
# Used to sponsor/mint destination transactions on Sui Testnet
VITE_SUI_RELAYER_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 3. Protocol Treasury Addresses (Base Network)
# ------------------------------------------------------------------------------
# Yucarn protocol fee recipient treasury address on Base.
# Default treasury: 0x127c1A164b00639FAA338E38F3150b12D313420A
VITE_YUCARN_TREASURY_ADDRESS=0x127c1A164b00639FAA338E38F3150b12D313420A
VITE_YUCARN_TESTNET_TREASURY_ADDRESS=0x127c1A164b00639FAA338E38F3150b12D313420A

# Legacy aliases (supported for backwards compatibility)
VITE_UNIPAY_TREASURY_ADDRESS=0x127c1A164b00639FAA338E38F3150b12D313420A
VITE_UNIPAY_TESTNET_TREASURY_ADDRESS=0x127c1A164b00639FAA338E38F3150b12D313420A
